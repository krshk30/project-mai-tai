[Unit]
Description=Bounded TODAY ATR simulation file (no trading writes)
After=network.target

[Service]
Type=oneshot
User=trader
Group=trader
WorkingDirectory=/home/trader/project-mai-tai
EnvironmentFile=/etc/project-mai-tai/project-mai-tai.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/ionice -c 3 /home/trader/project-mai-tai/.venv/bin/python /home/trader/project-mai-tai/tools/atrsimlive1_refresh_job.py --source-manifest /etc/project-mai-tai/atrsimlive1-source.json --policy /var/lib/project-mai-tai/atr-simulation/policy/oct5-condition-rules.json --incremental-cache-root /var/lib/project-mai-tai/atr-simulation/today/cache-v2 --evidence-root /var/lib/project-mai-tai/atr-simulation/today/evidence --dsn-env MAI_TAI_DATABASE_URL --cache-closed-components
# Type=oneshot uses TimeoutStartSec, not RuntimeMaxSec.
TimeoutStartSec=150
TimeoutStopSec=4
KillMode=control-group
Restart=no
Nice=19
IOSchedulingClass=idle
CPUQuota=100%
MemoryMax=2G
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
StateDirectory=project-mai-tai/atr-simulation/today
StateDirectoryMode=0750
ReadWritePaths=/var/lib/project-mai-tai/atr-simulation/today
UMask=0077
