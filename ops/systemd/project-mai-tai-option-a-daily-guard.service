[Unit]
Description=Restart-safe guarded Momentum session
After=network-online.target redis-server.service project-mai-tai-market-data.service
Wants=network-online.target
OnFailure=project-mai-tai-option-a-daily-guard-failure.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=all
WatchdogSec=15s
TimeoutStartSec=60s
User=root
WorkingDirectory=/home/trader/project-mai-tai
EnvironmentFile=/etc/project-mai-tai/project-mai-tai.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/trader/project-mai-tai/.venv/bin/python -B /home/trader/option-a-daily-guard/daily_guard.py
ExecStartPost=/bin/systemctl start project-mai-tai-momentum-paper.service
ExecStopPost=/bin/systemctl stop project-mai-tai-momentum-paper.service
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78
UMask=0077
StandardOutput=journal
StandardError=journal
