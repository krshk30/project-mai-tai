[Unit]
Description=TODAY ATR simulations every five minutes during the ET session

[Timer]
OnCalendar=*-*-* 04..19:00/5:00 America/New_York
OnCalendar=*-*-* 20:00:00 America/New_York
OnCalendar=*-*-* 20:05:00 America/New_York
AccuracySec=1s
RandomizedDelaySec=0
Persistent=false
Unit=project-mai-tai-atr-sim-today.service

[Install]
WantedBy=timers.target
