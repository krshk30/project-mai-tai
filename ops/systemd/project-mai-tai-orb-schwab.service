[Unit]
Description=Project Mai Tai separate default-off ORB Schwab producer
After=network-online.target postgresql.service redis-server.service project-mai-tai-market-data.service project-mai-tai-oms.service
Wants=network-online.target

[Service]
Type=simple
User=trader
Group=trader
WorkingDirectory=/home/trader/project-mai-tai
EnvironmentFile=/etc/project-mai-tai/project-mai-tai.env
ExecStart=/home/trader/project-mai-tai/.venv/bin/mai-tai-orb-schwab
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
UMask=0027
StandardOutput=append:/var/log/project-mai-tai/orb-schwab.log
StandardError=append:/var/log/project-mai-tai/orb-schwab.log
SyslogIdentifier=project-mai-tai-orb-schwab
