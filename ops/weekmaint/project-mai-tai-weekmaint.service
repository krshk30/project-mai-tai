[Unit]
Description=Reviewed bot-only weekly maintenance (explicit private manifest required)
After=network-online.target project-mai-tai-momlive-sec.service
OnFailure=project-mai-tai-weekmaint-failed.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/trader/project-mai-tai
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/project-mai-tai/project-mai-tai.env
UMask=0077
ExecStart=/home/trader/project-mai-tai/.venv/bin/python -B -m ops.weekmaint.backend --execute
Restart=no
# A package overrun is durably flagged, never killed mid-dpkg. Supervised review
# is required; the backend does not advance to reboot after an overrun.
TimeoutStartSec=infinity
SyslogIdentifier=project-mai-tai-weekmaint
