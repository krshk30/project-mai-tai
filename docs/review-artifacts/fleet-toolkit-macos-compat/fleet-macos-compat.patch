--- live-original-normalized/portable.sh	1969-12-31 19:00:00
+++ live-copy-safety-normalized/portable.sh	2026-08-31 10:24:26
@@ -0,0 +1,109 @@
+#!/usr/bin/env bash
+# Shared BSD/GNU compatibility helpers for the fleet scripts.
+# Exact-path overrides are intentionally variant-specific: BSD and GNU options differ.
+
+_exact_executable() {
+  local path="$1" label="$2"
+  case "$path" in
+    /*) ;;
+    *) echo "⛔ $label must be an absolute executable path (got '${path:-<empty>}')." >&2; return 127 ;;
+  esac
+  [ -x "$path" ] || { echo "⛔ $label is not executable: $path" >&2; return 127; }
+}
+
+hash_sha256() {
+  if [ "${FLEET_SHA256SUM+x}" = x ]; then
+    _exact_executable "$FLEET_SHA256SUM" FLEET_SHA256SUM || return
+    "$FLEET_SHA256SUM" "$@"
+  elif [ "${FLEET_SHASUM+x}" = x ]; then
+    _exact_executable "$FLEET_SHASUM" FLEET_SHASUM || return
+    "$FLEET_SHASUM" -a 256 "$@"
+  elif command -v sha256sum >/dev/null 2>&1; then
+    sha256sum "$@"
+  elif command -v shasum >/dev/null 2>&1; then
+    shasum -a 256 "$@"
+  else
+    echo "⛔ neither sha256sum nor shasum is available." >&2
+    return 127
+  fi
+}
+
+hash_md5() {
+  if [ "${FLEET_MD5SUM+x}" = x ]; then
+    _exact_executable "$FLEET_MD5SUM" FLEET_MD5SUM || return
+    "$FLEET_MD5SUM" "$@"
+  elif [ "${FLEET_MD5+x}" = x ]; then
+    _exact_executable "$FLEET_MD5" FLEET_MD5 || return
+    if [ "$#" -eq 0 ]; then "$FLEET_MD5" -q; else "$FLEET_MD5" -q "$@"; fi
+  elif command -v md5sum >/dev/null 2>&1; then
+    md5sum "$@"
+  elif command -v md5 >/dev/null 2>&1; then
+    if [ "$#" -eq 0 ]; then
+      md5 -q
+    else
+      md5 -q "$@"
+    fi
+  else
+    echo "⛔ neither md5sum nor md5 is available." >&2
+    return 127
+  fi
+}
+
+stat_mtime_epoch() {
+  if [ "${FLEET_BSD_STAT+x}" = x ]; then
+    _exact_executable "$FLEET_BSD_STAT" FLEET_BSD_STAT || return
+    "$FLEET_BSD_STAT" -f %m "$1"
+  elif [ "${FLEET_GNU_STAT+x}" = x ]; then
+    _exact_executable "$FLEET_GNU_STAT" FLEET_GNU_STAT || return
+    "$FLEET_GNU_STAT" -c %Y "$1"
+  elif stat -f %m "$1" >/dev/null 2>&1; then
+    stat -f %m "$1"
+  elif stat -c %Y "$1" >/dev/null 2>&1; then
+    stat -c %Y "$1"
+  else
+    echo "⛔ stat cannot report an mtime with BSD -f or GNU -c." >&2
+    return 127
+  fi
+}
+
+date_utc_from_epoch() {
+  if [ "${FLEET_BSD_DATE+x}" = x ]; then
+    _exact_executable "$FLEET_BSD_DATE" FLEET_BSD_DATE || return
+    "$FLEET_BSD_DATE" -u -r "$1" +%Y-%m-%dT%H:%M:%S
+  elif [ "${FLEET_GNU_DATE+x}" = x ]; then
+    _exact_executable "$FLEET_GNU_DATE" FLEET_GNU_DATE || return
+    "$FLEET_GNU_DATE" -u -d "@$1" +%Y-%m-%dT%H:%M:%S
+  elif date -u -r "$1" +%Y-%m-%dT%H:%M:%S >/dev/null 2>&1; then
+    date -u -r "$1" +%Y-%m-%dT%H:%M:%S
+  elif date -u -d "@$1" +%Y-%m-%dT%H:%M:%S >/dev/null 2>&1; then
+    date -u -d "@$1" +%Y-%m-%dT%H:%M:%S
+  else
+    echo "⛔ date cannot convert an epoch with BSD -r or GNU -d." >&2
+    return 127
+  fi
+}
+
+python_cmd() {
+  if [ "${FLEET_PYTHON+x}" = x ]; then
+    _exact_executable "$FLEET_PYTHON" FLEET_PYTHON || return
+    printf '%s\n' "$FLEET_PYTHON"
+  elif command -v python >/dev/null 2>&1; then
+    printf '%s\n' python
+  elif command -v python3 >/dev/null 2>&1; then
+    printf '%s\n' python3
+  else
+    return 1
+  fi
+}
+
+json_eval() {
+  local expr="$1"
+  local py
+  py="$(python_cmd)" || return 127
+  printf '%s' "$2" | "$py" -c "import json,sys; d=json.load(sys.stdin); $expr" 2>/dev/null
+}
+
+gh_json_field() {
+  local json="$1" expr="$2"
+  json_eval "$expr" "$json"
+}
