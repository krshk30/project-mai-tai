diff -ruN live-original-normalized/checksums.sh live-copy-safety-normalized/checksums.sh
--- live-original-normalized/checksums.sh	2026-08-30 19:10:23
+++ live-copy-safety-normalized/checksums.sh	2026-08-31 10:24:26
@@ -5,14 +5,72 @@
 #   ./checksums.sh verify   fail if any gate script changed since it was pinned
 set -uo pipefail
 R="$(cd "$(dirname "$0")" && pwd)"; F="$R/.checksums"
+. "$R/portable.sh"
 files() { ls "$R"/*.sh "$R"/fleet.cmd 2>/dev/null | grep -v checksums.sh; }
+
+parse_checksum_line() {
+  local line="$1"
+  checksum_want="${line%% *}"
+  [ "$checksum_want" != "$line" ] || return 1
+  checksum_file="${line#* }"
+  case "$checksum_file" in
+    " "*) checksum_file="${checksum_file# }" ;; # BSD/shasum: hash<space><space>path
+    \**)  checksum_file="${checksum_file#\*}" ;; # GNU binary mode: hash<space>*path
+    *) return 1 ;;
+  esac
+  [ "${#checksum_want}" -eq 64 ] && [ -n "$checksum_file" ] || return 1
+  case "$checksum_want" in *[!0-9a-fA-F]*) return 1 ;; esac
+}
+
+record_checksums() {
+  local tmp hash f
+  tmp=$(mktemp "$R/.checksums.tmp.XXXXXX") || {
+    echo "⛔ COULD_NOT_TELL — cannot create a temporary checksum manifest." >&2
+    return 3
+  }
+  if files | while IFS= read -r f; do
+       hash=$(hash_sha256 "$f" 2>/dev/null | awk '{print $1}')
+       [ "${#hash}" -eq 64 ] || exit 1
+       case "$hash" in *[!0-9a-fA-F]*) exit 1 ;; esac
+       # Always record one canonical format, regardless of the selected hash implementation.
+       printf '%s  %s\n' "$hash" "$f"
+     done > "$tmp"
+  then
+    mv "$tmp" "$F" || { rm -f "$tmp"; return 3; }
+  else
+    rm -f "$tmp"
+    echo "⛔ COULD_NOT_TELL — checksum recording failed; the previous pin was preserved." >&2
+    return 3
+  fi
+}
+
+report_drift() {
+  if [ "$drift" -eq 0 ]; then
+    echo "⛔ GATE SCRIPTS HAVE DRIFTED since pinning:" >&2
+  fi
+  drift=1
+  printf '   %s: FAILED\n' "$1" >&2
+}
+
 case "${1:-verify}" in
-record) files | xargs sha256sum > "$F"; echo "pinned $(wc -l < "$F") file(s) -> .checksums" ;;
+record) record_checksums || exit $?
+  echo "pinned $(wc -l < "$F") file(s) -> .checksums" ;;
 verify) [ -f "$F" ] || { echo "⛔ COULD_NOT_TELL — nothing pinned yet. Run: ./checksums.sh record" >&2; exit 3; }
-  if sha256sum -c "$F" --quiet 2>/dev/null; then echo "✅ gate scripts unchanged since pinning"
-  else echo "⛔ GATE SCRIPTS HAVE DRIFTED since pinning:" >&2
-       sha256sum -c "$F" 2>/dev/null | grep -v ': OK$' | sed 's/^/   /' >&2
-       echo "   ⇒ review the change, then ./checksums.sh record. An unreviewed gate is not a gate." >&2
-       exit 1; fi ;;
+  drift=0
+  while IFS= read -r line; do
+    [ -n "$line" ] || continue
+    if ! parse_checksum_line "$line"; then
+      report_drift "MALFORMED CHECKSUM RECORD"
+      continue
+    fi
+    got=$(hash_sha256 "$checksum_file" 2>/dev/null | awk '{print $1}')
+    [ "$checksum_want" = "$got" ] || report_drift "$checksum_file"
+  done < "$F"
+  if [ "$drift" -eq 0 ]; then
+    echo "✅ gate scripts unchanged since pinning"
+  else
+    echo "   ⇒ review the change, then ./checksums.sh record. An unreviewed gate is not a gate." >&2
+    exit 1
+  fi ;;
 *) echo "usage: checksums.sh record|verify" >&2; exit 2 ;;
 esac
