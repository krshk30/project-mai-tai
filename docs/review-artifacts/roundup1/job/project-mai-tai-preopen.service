[Unit]
Description=Daily preopen checks with pinned services and guard-qualified paper
After=network-online.target
OnFailure=project-mai-tai-preopen-failure.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/home/trader/project-mai-tai
UnsetEnvironment=TZ
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/trader/preopen-daily/run.sh
TimeoutStartSec=300
Restart=no
UMask=0077
StandardOutput=journal
StandardError=journal
