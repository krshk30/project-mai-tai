[Unit]
Description=Saturday resize cold Redis bootstrap and post-reboot proof
Wants=network-online.target
Requires=redis-server.service postgresql@16-main.service
After=network-online.target redis-server.service postgresql@16-main.service
ConditionPathExists=/home/trader/after-hours/2026-10-03/resize-run/PREPARED.json
ConditionPathExists=!/home/trader/after-hours/2026-10-03/resize-run/postboot-claim.json

[Service]
Type=oneshot
User=root
UMask=0077
ExecCondition=/home/trader/project-mai-tai/.venv/bin/python /home/trader/after-hours/2026-10-03/resize-job/review_gate.py
ExecStart=/bin/bash /home/trader/after-hours/2026-10-03/resize-job/run_resize.sh postboot
Restart=no
RemainAfterExit=yes
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
